# ==============================================================================
# Powerpolis — EnergiAI Model Service — Variáveis de Ambiente
# ==============================================================================
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente.
# NUNCA commite o .env real (ele está no .gitignore).
# ==============================================================================

# --- Fonte do Modelo ---
# "local" = carrega do sistema de arquivos (padrão para dev / Docker Compose)
# "oci"   = baixa do OCI Object Storage (produção)
MODEL_SOURCE=local

# --- Modo Local ---
# Caminho relativo ao diretório de trabalho da aplicação
MODEL_LOCAL_PATH=models/modelo_energiai_v1.pkl

# --- Modo OCI ---
# Configurações do OCI Object Storage (usadas apenas quando MODEL_SOURCE=oci)
OCI_REGION=sa-saopaulo-1
OCI_NAMESPACE=grclodnfw2hl
OCI_OBJECT_STORAGE_BUCKET=powerpolis-bucket-models
OCI_MODEL_OBJECT_NAME=models/modelo_energiai_v1.pkl
